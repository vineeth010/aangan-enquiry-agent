# Copy to .env.local and fill in. Never commit real values.

# Neon connection string. For local runs without Neon use: pglite:.pglite
DATABASE_URL=

# --- Vaani (verified: x-webhook-signature = sha256=HMAC-SHA256 hex of raw body) ---
VAANI_WEBHOOK_SECRET=
VAANI_SIGNATURE_HEADER=x-webhook-signature

# --- Gemini (evaluation only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Google Calendar (service account; each designer shares their calendar with its email) ---
# Paste the whole service-account JSON key as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
CALENDAR_TIMEZONE=Asia/Kolkata

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <enquiries@YOUR-VERIFIED-DOMAIN>
# While EMAIL_TEST_MODE is on (the default), every email goes to EMAIL_TEST_RECIPIENT. Set to false to email real people.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=
# Inbox that receives booking-failure flags (no caller details in these)
OPS_ALERT_EMAIL=

# --- HubSpot (aggregate metrics only) ---
HUBSPOT_TOKEN=
HUBSPOT_COMPANY_ID=

# --- Designer dashboard ---
# Shared demo password (default designer_aangan). Change before real use, then re-run db:seed-designers.
DESIGNER_PASSWORD=

# --- Access ---
# Bearer token for Founder metrics + retry job. Generate a long random string.
FOUNDER_TOKEN=
JOBS_TOKEN=
